# Copy this file to .env and fill in your own values. .env is git-ignored.

# ---- Reading patient messages -------------------------------------------------
# Gemini. Free, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Groq. Also free: https://console.groq.com
# Optional. Faster than Gemini per call, but its free allowance is measured in tokens
# rather than requests, so it runs out sooner. Leave it blank to use Gemini only.
GROQ_API_KEY=

# ---- Stamping the conversation ------------------------------------------------
# The server keeps no memory between messages: the conversation travels with the patient
# and is stamped so it cannot be edited. See clinikit/agent/state.py.
#
# Locally you can leave this blank and a public development value is used. In production
# it MUST be set, or anyone could forge an offer the clinic never made.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CLINIKIT_STATE_SECRET=

# ---- Optional tuning ----------------------------------------------------------
# CLINIKIT_BACKEND=auto           which reader the web page uses by default
# CLINIKIT_PROVIDERS=gemini       which providers "auto" tries, in order
# CLINIKIT_NATURAL_REPLIES=1      0 turns off the second AI call that softens wording
# CLINIKIT_CACHE_DIR=/tmp/clinikit   where cached answers go. Set this on any host with
#                                    a read-only disk, which is most of them.
