# Copy this file to .env and fill in your own key.
# Get one free (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Groq — free, no credit card. Get one at https://console.groq.com
# Preferred reader when tokens remain.
GROQ_API_KEY=your_key_here

# Optional tuning
# CLINIKIT_BACKEND=auto
# CLINIKIT_PROVIDERS=groq,gemini
# CLINIKIT_NATURAL_REPLIES=1
